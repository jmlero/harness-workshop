{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jmlero/harness-workshop/main/schemas/catalog.schema.json",
  "title": "harness-workshop catalog",
  "type": "object",
  "required": ["catalogVersion", "components"],
  "properties": {
    "catalogVersion": { "const": 2 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "kind", "name", "description", "scopes"],
        "properties": {
          "id": { "type": "string", "pattern": "^(block|skill|command|hook|plugin|tool)/[a-z0-9][a-z0-9-]*$" },
          "version": { "type": "string" },
          "kind": { "enum": ["block", "skill", "command", "hook", "plugin", "tool"] },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "license": { "type": "string" },
          "adapters": { "type": "array", "items": { "enum": ["claude", "grok"] }, "minItems": 1, "uniqueItems": true },
          "scopes": { "type": "array", "items": { "enum": ["project", "user"] }, "minItems": 1, "uniqueItems": true },
          "context": {
            "type": "object",
            "properties": {
              "loading": { "enum": ["always", "on-demand", "explicit", "none"] },
              "estimatedTokens": { "type": "integer", "minimum": 0 }
            }
          },
          "content": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "path"],
                "properties": {
                  "kind": { "const": "bundled" },
                  "path": { "type": "string" },
                  "root": { "type": "string" }
                }
              },
              {
                "type": "object",
                "required": ["kind", "url", "upstream"],
                "properties": {
                  "kind": { "const": "remote" },
                  "url": { "type": "string", "format": "uri" },
                  "upstream": { "type": "string" },
                  "mutable": { "type": "boolean" },
                  "root": { "type": "string" },
                  "overlay": { "type": "string" },
                  "licensePath": { "type": "string" },
                  "licenseTarget": { "type": "string" }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "enum": ["hook", "plugin"] } }, "required": ["kind"] },
            "then": { "required": ["adapters"] }
          },
          {
            "if": { "properties": { "kind": { "enum": ["skill", "command"] } }, "required": ["kind"] },
            "then": {
              "required": ["content", "context"],
              "properties": {
                "context": { "required": ["loading", "estimatedTokens"] }
              }
            }
          }
        ]
      }
    }
  }
}
