{
  "$schema": "../schemas/catalog.schema.json",
  "catalogVersion": 2,
  "components": [
    {
      "id": "block/tdd",
      "version": "1.0.0",
      "kind": "block",
      "name": "Test-driven development",
      "category": "Development methodology",
      "description": "A compact Red-Green-Refactor agreement managed in AGENTS.md.",
      "scopes": ["project"],
      "content": { "kind": "bundled", "path": "blocks/tdd.md" },
      "context": { "loading": "always", "estimatedTokens": 120 },
      "suggest": { "when": "always", "reason": "portable development baseline" }
    },
    {
      "id": "skill/audit-code",
      "version": "1.0.0",
      "kind": "skill",
      "name": "Production readiness audit",
      "category": "Code quality",
      "description": "Audit security, errors, validation, persistence, infrastructure, tests, and dependencies before release.",
      "scopes": ["project", "user"],
      "content": { "kind": "bundled", "path": "skills/audit-code/SKILL.md" },
      "context": { "loading": "on-demand", "estimatedTokens": 650 },
      "suggest": { "when": "always", "reason": "core release-quality workflow" }
    },
    {
      "id": "skill/audit-docs",
      "version": "1.0.0",
      "kind": "skill",
      "name": "Documentation audit",
      "category": "Code quality",
      "description": "Audit documentation for accuracy, staleness, duplication, broken references, and unnecessary context cost.",
      "scopes": ["project", "user"],
      "content": { "kind": "bundled", "path": "skills/audit-docs/SKILL.md" },
      "context": { "loading": "on-demand", "estimatedTokens": 600 },
      "suggest": { "when": ["hasDocs"], "reason": "documentation detected" }
    },
    {
      "id": "skill/review-pr",
      "version": "1.0.0",
      "kind": "skill",
      "name": "Pull request review",
      "category": "Code quality",
      "description": "Review a pull request for correctness, security, tests, compatibility, and project conventions.",
      "scopes": ["project", "user"],
      "content": { "kind": "bundled", "path": "skills/review-pr/SKILL.md" },
      "context": { "loading": "on-demand", "estimatedTokens": 550 },
      "suggest": { "when": ["isGitRepo"], "reason": "Git repository detected" }
    },
    {
      "id": "hook/slim-cli",
      "version": "2.0.0",
      "kind": "hook",
      "name": "Slim CLI output",
      "category": "Operations",
      "description": "Claude-only PreToolUse hook that adds safe quiet flags without truncating diagnostics or changing command semantics.",
      "adapters": ["claude"],
      "scopes": ["project", "user"],
      "recommendedScope": "user",
      "content": { "kind": "bundled", "path": "../adapters/claude/hooks/slim-cli/slim-cli.sh" },
      "context": { "loading": "none", "estimatedTokens": 0 }
    },
    {
      "id": "plugin/frontend-design",
      "version": "1.0.0",
      "kind": "plugin",
      "name": "Frontend design",
      "category": "Anthropic",
      "description": "Official Claude plugin for production-grade frontend design.",
      "adapters": ["claude"],
      "scopes": ["project", "user"],
      "adapter": { "claude": { "pluginId": "frontend-design", "marketplace": { "name": "claude-plugins-official", "repo": "anthropics/claude-plugins-official" } } },
      "suggest": { "when": ["hasReact", "hasNextJs", "hasVue", "hasSvelte"], "reason": "frontend framework detected" }
    },
    {
      "id": "plugin/typescript-lsp",
      "version": "1.0.0",
      "kind": "plugin",
      "name": "TypeScript LSP",
      "category": "Anthropic",
      "description": "Official Claude TypeScript language-server integration.",
      "adapters": ["claude"],
      "scopes": ["project", "user"],
      "recommendedScope": "user",
      "adapter": { "claude": { "pluginId": "typescript-lsp", "marketplace": { "name": "claude-plugins-official", "repo": "anthropics/claude-plugins-official" } } },
      "suggest": { "when": ["hasTypeScript"], "reason": "TypeScript detected" }
    },
    {
      "id": "plugin/pyright-lsp",
      "version": "1.0.0",
      "kind": "plugin",
      "name": "Pyright LSP",
      "category": "Anthropic",
      "description": "Official Claude Python type-checking integration.",
      "adapters": ["claude"],
      "scopes": ["project", "user"],
      "recommendedScope": "user",
      "adapter": { "claude": { "pluginId": "pyright-lsp", "marketplace": { "name": "claude-plugins-official", "repo": "anthropics/claude-plugins-official" } } },
      "suggest": { "when": ["hasPython"], "reason": "Python detected" }
    },
    {
      "id": "plugin/github",
      "version": "1.0.0",
      "kind": "plugin",
      "name": "GitHub",
      "category": "Anthropic",
      "description": "Official Claude integration for GitHub issues, pull requests, and actions.",
      "adapters": ["claude"],
      "scopes": ["project", "user"],
      "adapter": { "claude": { "pluginId": "github", "marketplace": { "name": "claude-plugins-official", "repo": "anthropics/claude-plugins-official" } } },
      "suggest": { "when": ["isGitHubRepo"], "reason": "GitHub remote detected" }
    },
    {
      "id": "plugin/terraform",
      "version": "1.0.0",
      "kind": "plugin",
      "name": "HashiCorp Terraform skills",
      "category": "Community",
      "description": "HashiCorp skills for HCL, Stacks, modules, and provider development.",
      "adapters": ["claude"],
      "scopes": ["project", "user"],
      "adapter": { "claude": { "pluginId": "terraform", "marketplace": { "name": "hashicorp", "repo": "hashicorp/agent-skills" } } }
    },
    {
      "id": "skill/terraform-skill",
      "version": "1.0.0",
      "kind": "skill",
      "name": "Terraform skill",
      "category": "Community",
      "description": "Portable Terraform and OpenTofu module, testing, CI/CD, and security guidance.",
      "scopes": ["project", "user"],
      "content": {
        "kind": "remote",
        "url": "https://raw.githubusercontent.com/antonbabenko/terraform-skill/master/skills/terraform-skill/SKILL.md",
        "upstream": "antonbabenko/terraform-skill",
        "mutable": true
      },
      "license": "Apache-2.0",
      "context": { "loading": "on-demand" },
      "suggest": { "when": ["hasTerraform"], "reason": "Terraform detected" }
    },
    {
      "id": "plugin/superpowers",
      "version": "1.0.0",
      "kind": "plugin",
      "name": "Superpowers",
      "category": "Community",
      "description": "Community methodology skills for TDD, debugging, planning, and verification.",
      "adapters": ["claude"],
      "scopes": ["project", "user"],
      "adapter": { "claude": { "pluginId": "superpowers", "marketplace": { "name": "obra", "repo": "obra/superpowers" } } }
    },
    {
      "id": "plugin/codex",
      "version": "1.0.0",
      "kind": "plugin",
      "name": "Codex for Claude",
      "category": "Community",
      "description": "Claude plugin that exposes the Codex CLI as a tool.",
      "adapters": ["claude"],
      "scopes": ["project", "user"],
      "adapter": { "claude": { "pluginId": "codex", "marketplace": { "name": "openai-codex", "repo": "openai/codex-plugin-cc" } } }
    },
    {
      "id": "tool/code-review-graph",
      "version": "1.0.0",
      "kind": "tool",
      "name": "Code Review Graph",
      "category": "External tool",
      "description": "Code knowledge graph with blast-radius analysis and incremental indexing.",
      "scopes": ["user"],
      "manual": { "install": "pipx install code-review-graph && code-review-graph install", "postInstall": "code-review-graph build" },
      "suggest": { "when": "always", "reason": "useful on unfamiliar or large repositories" }
    },
    {
      "id": "tool/codegraph",
      "version": "1.0.0",
      "kind": "tool",
      "name": "CodeGraph",
      "category": "External tool",
      "description": "Node-based code knowledge graph alternative.",
      "scopes": ["user"],
      "manual": { "install": "npx @colbymchenry/codegraph", "postInstall": "codegraph init" }
    },
    {
      "id": "tool/context7",
      "version": "1.0.0",
      "kind": "tool",
      "name": "Context7",
      "category": "External tool",
      "description": "Fetch current version-specific library documentation.",
      "scopes": ["user"],
      "manual": { "install": "npx ctx7@latest setup" },
      "suggest": { "when": "always", "reason": "reduces stale API guidance" }
    },
    {
      "id": "tool/backlog",
      "version": "1.0.0",
      "kind": "tool",
      "name": "Backlog.md",
      "category": "External tool",
      "description": "Markdown-native task manager and Kanban UI for Git repositories.",
      "scopes": ["user"],
      "manual": { "install": "npm install --global backlog.md", "postInstall": "backlog init" }
    },
    {
      "id": "skill/fastapi",
      "version": "1.0.0",
      "kind": "skill",
      "name": "FastAPI",
      "category": "Framework skill",
      "description": "Official FastAPI guidance for typing, dependency injection, async behavior, and streaming.",
      "scopes": ["project", "user"],
      "content": {
        "kind": "remote",
        "url": "https://raw.githubusercontent.com/fastapi/fastapi/master/fastapi/.agents/skills/fastapi/SKILL.md",
        "upstream": "fastapi/fastapi",
        "mutable": true
      },
      "context": { "loading": "on-demand" },
      "suggest": { "when": ["hasFastAPI"], "reason": "FastAPI detected" }
    }
  ]
}
