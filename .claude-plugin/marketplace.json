{
  "name": "jmlero",
  "owner": { "name": "jmlero" },
  "metadata": {
    "description": "Claude adapter for portable harness-workshop skills and hooks",
    "version": "0.1.0"
  },
  "description": "Portable harness-workshop skills and Claude-specific hooks",
  "plugins": [
    {
      "name": "audit-code",
      "source": "./",
      "description": "Production readiness audit",
      "version": "1.0.0",
      "license": "Apache-2.0",
      "skills": ["./adapters/claude/plugins/audit-code/skills/audit-code"],
      "strict": false,
      "keywords": ["audit", "security", "production"]
    },
    {
      "name": "audit-docs",
      "source": "./",
      "description": "Documentation accuracy and context-cost audit",
      "version": "1.0.0",
      "license": "Apache-2.0",
      "skills": ["./adapters/claude/plugins/audit-docs/skills/audit-docs"],
      "strict": false,
      "keywords": ["audit", "documentation", "markdown"]
    },
    {
      "name": "review-pr",
      "source": "./",
      "description": "Evidence-backed pull request review",
      "version": "1.0.0",
      "license": "Apache-2.0",
      "skills": ["./adapters/claude/plugins/review-pr/skills/review-pr"],
      "strict": false,
      "keywords": ["review", "pull-request", "security"]
    },
    {
      "name": "slim-cli",
      "source": "./",
      "description": "Opt-in safe quiet-flag hook",
      "version": "2.0.0",
      "license": "Apache-2.0",
      "hooks": "./adapters/claude/plugins/slim-cli/hooks/hooks.json",
      "strict": false,
      "keywords": ["cli", "hook", "context"]
    }
  ]
}
